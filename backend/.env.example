GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
API_KEY=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
PORT=4000
DUCKDB_PATH=./data/market.duckdb
# The transactional store for the order domain. Optional in development — leave it unset and
# the order routes are simply unavailable; everything else works. Required in production.
DATABASE_URL=postgres://stp:stp@localhost:5432/stp
PG_POOL_MAX=10
JSON_BODY_LIMIT=2mb
TRUST_PROXY=0
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=15000
LOG_LEVEL=info
LOG_FORMAT=json

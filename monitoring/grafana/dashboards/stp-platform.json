{
  "uid": "stp-platform",
  "title": "STP Trading Platform",
  "description": "System health and live paper-trading performance for the STP backend. Provisioned from monitoring/grafana/dashboards/stp-platform.json.",
  "tags": ["stp", "trading", "backend"],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "symbol",
        "label": "Symbol",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
        "query": "label_values(stp_session_equity_usd, symbol)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Backend",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [{ "expr": "up{job=\"stp-backend\"}", "refId": "A", "instant": true }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        { "expr": "time() - stp_process_start_time_seconds{job=\"stp-backend\"}", "refId": "A", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none"
      },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Requests / sec",
      "gridPos": { "h": 4, "w": 5, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        { "expr": "sum(rate(stp_http_requests_total[$__rate_interval]))", "refId": "A", "instant": true }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "area"
      },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Error rate",
      "description": "Share of responses with a 4xx or 5xx status.",
      "gridPos": { "h": 4, "w": 5, "x": 13, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        {
          "expr": "100 * sum(rate(stp_http_requests_total{status=~\"4..|5..\"}[$__rate_interval])) / clamp_min(sum(rate(stp_http_requests_total[$__rate_interval])), 0.0001)",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "p95 latency",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stp_http_request_duration_seconds_bucket[$__rate_interval])))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        },
        "overrides": []
      }
    },

    {
      "type": "row",
      "title": "Paper trading performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Cumulative P&L",
      "description": "Live P&L of each replayed session versus its starting cash. Driven by the replay controls in the app, so stepping the simulation moves this chart.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        { "expr": "stp_session_pnl_usd{symbol=~\"$symbol\"}", "refId": "A", "legendFormat": "{{symbol}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0
          },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Drawdown from peak",
      "description": "Current drawdown (solid) against the worst seen so far (dashed). Both are computed by the deterministic performance module, not sampled.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        { "expr": "stp_session_drawdown_pct{symbol=~\"$symbol\"}", "refId": "A", "legendFormat": "{{symbol}} current" },
        { "expr": "stp_session_max_drawdown_pct{symbol=~\"$symbol\"}", "refId": "B", "legendFormat": "{{symbol}} max" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          },
          "color": { "mode": "palette-classic" }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".* max" },
            "properties": [
              { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 6] } },
              { "id": "custom.fillOpacity", "value": 0 }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Session equity",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        { "expr": "stp_session_equity_usd{symbol=~\"$symbol\"}", "refId": "A", "legendFormat": "{{symbol}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Exposure & trade count",
      "description": "Share of replayed bars spent holding a position, alongside cumulative trades executed.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        { "expr": "stp_session_exposure_pct{symbol=~\"$symbol\"}", "refId": "A", "legendFormat": "{{symbol}} exposure" },
        { "expr": "stp_session_trades{symbol=~\"$symbol\"}", "refId": "B", "legendFormat": "{{symbol}} trades" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".* trades" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.drawStyle", "value": "line" },
              { "id": "custom.lineStyle", "value": { "fill": "dot", "dash": [1, 4] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Risk alerts raised",
      "description": "Cumulative alerts from the deterministic risk engine, by severity. Compliance drafts are counted separately and are never auto-filed.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 13 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        { "expr": "sum by (severity) (stp_risk_alerts_total)", "refId": "A", "legendFormat": "risk: {{severity}}" },
        { "expr": "sum(stp_compliance_drafts_total)", "refId": "B", "legendFormat": "compliance drafts" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "risk: high" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "risk: medium" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "risk: low" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },

    {
      "type": "row",
      "title": "Service health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 20 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate by route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        {
          "expr": "sum by (route) (rate(stp_http_requests_total[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "stacking": { "mode": "normal" }, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP latency quantiles",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(stp_http_request_duration_seconds_bucket[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stp_http_request_duration_seconds_bucket[$__rate_interval])))",
          "refId": "B",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(stp_http_request_duration_seconds_bucket[$__rate_interval])))",
          "refId": "C",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        { "expr": "stp_process_resident_memory_bytes{job=\"stp-backend\"}", "refId": "A", "legendFormat": "resident" },
        { "expr": "sum(stp_nodejs_heap_size_used_bytes{job=\"stp-backend\"})", "refId": "B", "legendFormat": "heap used" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "CPU & event-loop lag",
      "description": "Event-loop lag is the number to watch: the replay engine recomputes a strategy synchronously on every step, so a rising lag means the API is starving.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        {
          "expr": "rate(stp_process_cpu_seconds_total{job=\"stp-backend\"}[$__rate_interval])",
          "refId": "A",
          "legendFormat": "cpu cores"
        },
        {
          "expr": "stp_nodejs_eventloop_lag_mean_seconds{job=\"stp-backend\"}",
          "refId": "B",
          "legendFormat": "event-loop lag"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 4,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "event-loop lag" },
            "properties": [{ "id": "unit", "value": "s" }, { "id": "custom.axisPlacement", "value": "right" }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "DuckDB query time (p95)",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 29 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(stp_duckdb_query_duration_seconds_bucket[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Gen-AI agent latency (p95)",
      "description": "Groq call latency per agent, measured across retries — the wait a user actually experiences.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, agent) (rate(stp_llm_request_duration_seconds_bucket[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{agent}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Gen-AI agent outcomes",
      "description": "Cumulative agent calls by outcome, plus schema-validation retries. 'validation_failed' means the model never produced schema-valid JSON; 'error' means the API call itself failed. Separating them tells 'Groq is down' apart from 'Groq is rambling'.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        { "expr": "sum by (outcome) (stp_llm_requests_total)", "refId": "A", "legendFormat": "{{outcome}}" },
        { "expr": "sum(stp_llm_validation_retries_total)", "refId": "B", "legendFormat": "schema retries" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "validation_failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Replay engine",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 43 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Strategy replay time (p95)",
      "description": "Every replay control action re-runs the strategy from bar zero, so this is the platform's hottest CPU path. Replay rate is on the right axis.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, kind) (rate(stp_strategy_replay_duration_seconds_bucket[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{kind}}"
        },
        {
          "expr": "sum by (kind) (rate(stp_strategy_replay_duration_seconds_count[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "{{kind}} replays/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".* replays/s" },
            "properties": [
              { "id": "unit", "value": "ops" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.lineStyle", "value": { "fill": "dot", "dash": [1, 4] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Replay activity",
      "description": "Sessions currently held in memory, with the rate of replay control actions and newly started sessions on the right axis.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        {
          "expr": "stp_simulation_sessions_active",
          "refId": "A",
          "legendFormat": "active sessions"
        },
        {
          "expr": "sum by (action) (rate(stp_simulation_actions_total[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "{{action}}/s"
        },
        {
          "expr": "sum(rate(stp_simulation_sessions_started_total[$__rate_interval]))",
          "refId": "C",
          "legendFormat": "sessions started/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*/s" },
            "properties": [
              { "id": "unit", "value": "ops" },
              { "id": "decimals", "value": 2 },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dot", "dash": [1, 4] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Return & Sharpe",
      "description": "Cumulative return of each live replay session, with its annualized Sharpe ratio on the right axis.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        {
          "expr": "stp_session_return_pct{symbol=~\"$symbol\"}",
          "refId": "A",
          "legendFormat": "{{symbol}} return"
        },
        {
          "expr": "stp_session_sharpe_ratio{symbol=~\"$symbol\"}",
          "refId": "B",
          "legendFormat": "{{symbol}} Sharpe"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".* Sharpe" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.fillOpacity", "value": 0 },
              { "id": "custom.lineStyle", "value": { "fill": "dot", "dash": [1, 4] } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "row",
      "title": "Market data, signals & load",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 51 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Bars ingested",
      "description": "Cumulative market data bars written into DuckDB, by symbol and bar size.",
      "gridPos": { "h": 7, "w": 6, "x": 0, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        {
          "expr": "sum by (symbol, interval) (stp_bars_ingested_total)",
          "refId": "A",
          "legendFormat": "{{symbol}} {{interval}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Upstream fetch latency (p95)",
      "description": "Yahoo Finance fetch latency by outcome. Cumulative fetch counts sit on the right axis, so a failing upstream still shows up when nothing is in flight.",
      "gridPos": { "h": 7, "w": 6, "x": 6, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(stp_market_data_fetch_duration_seconds_bucket[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "p95 {{outcome}}"
        },
        {
          "expr": "sum by (outcome) (stp_market_data_fetch_duration_seconds_count)",
          "refId": "B",
          "legendFormat": "{{outcome}} fetches"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".* fetches" },
            "properties": [
              { "id": "unit", "value": "short" },
              { "id": "decimals", "value": 0 },
              { "id": "custom.axisPlacement", "value": "right" },
              { "id": "custom.lineStyle", "value": { "fill": "dot", "dash": [1, 4] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "error fetches" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Technical signals generated",
      "description": "Cumulative technical-analytics signals by direction, across every indicator the signals endpoint evaluates.",
      "gridPos": { "h": 7, "w": 6, "x": 12, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        {
          "expr": "sum by (direction) (stp_analytics_signals_total)",
          "refId": "A",
          "legendFormat": "{{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never", "spanNulls": true }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "bullish" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "bearish" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "neutral" },
            "properties": [
              { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "type": "timeseries",
      "title": "Requests in flight",
      "description": "HTTP requests being handled concurrently. A rising floor here against flat throughput means requests are queueing.",
      "gridPos": { "h": 7, "w": 6, "x": 18, "y": 52 },
      "datasource": { "type": "prometheus", "uid": "stp-prometheus" },
      "targets": [
        {
          "expr": "stp_http_requests_in_flight",
          "refId": "A",
          "legendFormat": "in flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true, "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    }
  ]
}
